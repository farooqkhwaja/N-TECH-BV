<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="N-TECH BV - Uw partner in industriële techniek, metaalindustrie en montage">
  <meta name="keywords" content="metaalindustrie, montage, industriële techniek, N-TECH, Entec Services">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/main.js" defer></script>
</head>
<body>
  <header class="header">
    <div class="header-container">
      <!-- Logo -->
      <div class="logo-container">
        <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
          <img src="/images/logo.jpg" alt="N-TECH B.V. Logo" style="
            width: 50px;
            height: 50px;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
          ">
          <span class="logo-text">N-TECH B.V.</span>
        </a>
      </div>
      
      <!-- Mobile Menu Toggle -->
      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menu">
        <div class="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </button>
      
      <!-- Navigation -->
      <nav class="nav" id="mobileNav">
        <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">
          Home
        </a>
        <a href="/over-ons" class="nav-link <%= currentPage === 'about' ? 'active' : '' %>">
          Over Ons
        </a>
        <a href="/producten" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">
          Producten
        </a>
        <a href="/diensten" class="nav-link <%= currentPage === 'services' ? 'active' : '' %>">
          Diensten
        </a>
        <a href="/portfolio" class="nav-link <%= currentPage === 'portfolio' ? 'active' : '' %>">
          Portfolio
        </a>
        <a href="/entec-services" class="nav-link <%= currentPage === 'entec-services' ? 'active' : '' %>">
          Entec Services
        </a>
        <a href="/contact" class="nav-link <%= currentPage === 'contact' ? 'active' : '' %>">
          Contact
        </a>
      </nav>
    </div>
  </header>
