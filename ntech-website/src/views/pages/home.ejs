<%- include('../partials/header', { title: title, currentPage: currentPage }) %>

<!-- Hero Section -->
<section class="hero hero-home">
  <div class="hero-media" aria-hidden="true">
    <img src="<%= photoUrl('welding', 2000) %>" alt="" fetchpriority="high" onerror="this.remove()">
  </div>
  <canvas class="hero-sparks" aria-hidden="true"></canvas>

  <div class="hero-container">
    <span class="hero-eyebrow hero-anim">Metaalindustrie &amp; Montage</span>
    <h1 class="hero-anim">
      Uw partner in
      <span class="word-rotator" data-words="industriële techniek|staalconstructies|montage op maat|metaalbewerking">industriële techniek</span>
    </h1>
    <p class="hero-anim">
      Specialist in metaalindustrie en montage met meer dan 20 jaar ervaring.
      Wij leveren vakmanschap op maat voor de bouw- en industriesector.
    </p>
    <div class="btn-group hero-anim">
      <a href="/contact" class="btn btn-primary">Vraag een offerte aan</a>
      <a href="/diensten" class="btn btn-secondary">Onze diensten</a>
    </div>
    <ul class="hero-stats hero-anim">
      <li><strong><span data-count="20">20</span>+</strong> jaar ervaring</li>
      <li><strong><span data-count="3">3</span></strong> sectoren: metaal, bouw &amp; industrie</li>
      <li><strong><span data-count="100">100</span>%</strong> maatwerk</li>
    </ul>
  </div>

  <a href="#intro" class="scroll-cue" aria-label="Scroll naar beneden"><span></span></a>
</section>

<!-- Ticker -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <% for (let i = 0; i < 2; i++) { %>
      <span>Montage</span><span>Metaalbewerking</span><span>Staalconstructies</span><span>Industriële projecten</span><span>Uitzendbureau</span><span>Magazijnbeheer</span><span>Certificering</span>
    <% } %>
  </div>
</div>

<!-- Intro Section -->
<section class="section section-light" id="intro">
  <div class="container split">
    <div class="split-text">
      <span class="eyebrow">Over N-TECH B.V.</span>
      <h2>Vakmanschap waar u op kunt bouwen</h2>
      <p class="lead">
        N-TECH B.V. is een zelfstandig metaalindustrie- en montagebedrijf met een sterke focus op
        kwaliteit en betrouwbaarheid. Wij zijn actief in de metaalindustrie en bouwsector en nemen
        opdrachten aan waarbij vakmanschap centraal staat.
      </p>
      <ul class="check-list">
        <li>Montage en metaalbewerking op locatie</li>
        <li>Complete industriële opdrachten, van planning tot oplevering</li>
        <li>Gekwalificeerd personeel via ons uitzendbureau</li>
      </ul>
      <a href="/over-ons" class="btn btn-secondary">Meer over ons</a>
    </div>
    <div class="collage">
      <%- include('../partials/photo', { key: 'engineer', width: 900, className: 'collage-main' }) %>
      <%- include('../partials/photo', { key: 'sparks', width: 600, className: 'collage-small' }) %>
      <div class="collage-badge">
        <strong>20+</strong>
        <span>jaar ervaring</span>
      </div>
    </div>
  </div>
</section>

<!-- Services Preview -->
<section class="section section-dark">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Wat wij doen</span>
      <h2 class="section-title">Onze Kernactiviteiten</h2>
    </div>
    <div class="cards-grid">
      <a href="/diensten" class="card card-photo">
        <%- include('../partials/photo', { key: 'metalwork', width: 800 }) %>
        <div class="card-body">
          <div class="card-icon"><%- include('../partials/icon', { name: 'wrench', size: 32 }) %></div>
          <h3>Montage &amp; Metaalbewerking</h3>
          <p>Professionele montage en metaalbewerking voor industriële toepassingen.</p>
          <span class="card-link">Meer informatie</span>
        </div>
      </a>
      <a href="/diensten" class="card card-photo">
        <%- include('../partials/photo', { key: 'construction', width: 800 }) %>
        <div class="card-body">
          <div class="card-icon"><%- include('../partials/icon', { name: 'factory', size: 32 }) %></div>
          <h3>Industriële Opdrachten</h3>
          <p>Wij nemen complete industriële projecten aan en voeren deze vakkundig uit.</p>
          <span class="card-link">Meer informatie</span>
        </div>
      </a>
      <a href="/entec-services" class="card card-photo">
        <%- include('../partials/photo', { key: 'warehouse', width: 800 }) %>
        <div class="card-body">
          <div class="card-icon"><%- include('../partials/icon', { name: 'briefcase', size: 32 }) %></div>
          <h3>N-tech Services</h3>
          <p>Gespecialiseerde dienstverlening inclusief magazijnbeheer en certificering.</p>
          <span class="card-link">Meer informatie</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="section section-navy" style="--section-img: url('<%= photoUrl('steel', 1800) %>');">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Waarom N-TECH</span>
      <h2 class="section-title">Waarom Kiezen Voor N-TECH?</h2>
    </div>
    <div class="feature-grid">
      <div class="feature">
        <span class="feature-num">01</span>
        <h3>Ervaring</h3>
        <p>Meer dan 20 jaar ervaring in de metaalindustrie en industriële montage.</p>
      </div>
      <div class="feature">
        <span class="feature-num">02</span>
        <h3>Kwaliteit</h3>
        <p>Vakmanschap en precisie staan bij ons altijd op de eerste plaats.</p>
      </div>
      <div class="feature">
        <span class="feature-num">03</span>
        <h3>Betrouwbaarheid</h3>
        <p>Wij leveren wat we beloven en staan voor een eerlijke samenwerking.</p>
      </div>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="section section-light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">In beeld</span>
      <h2 class="section-title">Vakmanschap in Beeld</h2>
    </div>
    <div class="gallery">
      <figure class="gallery-item gallery-tall">
        <%- include('../partials/photo', { key: 'welding', width: 900 }) %>
        <figcaption>Laswerk</figcaption>
      </figure>
      <figure class="gallery-item">
        <%- include('../partials/photo', { key: 'installation', width: 700 }) %>
        <figcaption>Montage</figcaption>
      </figure>
      <figure class="gallery-item">
        <%- include('../partials/photo', { key: 'steel', width: 700 }) %>
        <figcaption>Staalconstructies</figcaption>
      </figure>
      <figure class="gallery-item gallery-wide">
        <%- include('../partials/photo', { key: 'specialist', width: 1200 }) %>
        <figcaption>Industriële installaties</figcaption>
      </figure>
    </div>
    <div class="text-center mt-2">
      <a href="/portfolio" class="btn btn-secondary">Bekijk ons portfolio</a>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="section cta-photo" style="--section-img: url('<%= photoUrl('sparks', 1800) %>');">
  <div class="container text-center">
    <h2 class="section-title">Klaar om samen te werken?</h2>
    <p>
      Neem contact met ons op en ontdek hoe N-TECH B.V. uw partner kan zijn
      in industriële techniek en metaalbewerking.
    </p>
    <div class="btn-group">
      <a href="/contact" class="btn btn-primary">Neem Contact Op</a>
      <a href="tel:+31616009703" class="btn btn-secondary">Bel +31 6 16 00 97 03</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
